{
  "workflow_name": "Autonomous_Dispute_Resolution_Pipeline",
  "version": "2.0",
  "intake_schema": {
    "step_1_intake": {
      "complaint_type": {
        "type": "string",
        "enum": [
          "Customer Complaint",
          "Order Dispute",
          "Refund Request",
          "Warranty Claim",
          "Delivery Issue",
          "Subscription Cancellation",
          "Service Escalation",
          "Product Return",
          "Billing Dispute"
        ],
        "required": true
      },
      "order_id": {
        "type": "string",
        "pattern": "^ORD-[0-9]{5,10}$",
        "required": true
      },
      "invoice_document": {
        "type": "file",
        "allowed_formats": ["pdf", "png", "jpg"],
        "pipeline": "Pipeline_B_Sandboxed_Doc",
        "required": true
      },
      "visual_evidence": {
        "type": "camera_live_capture",
        "allow_gallery": false,
        "gallery_blocked_policy": "ENFORCED_PLATFORM_WIDE",
        "pipeline": "Pipeline_A_Camera_Only",
        "required": true
      },
      "defect_description": {
        "type": "string",
        "min_length": 10,
        "required": true
      }
    }
  },
  "agent_execution_chain": [
    {
      "step": 1,
      "agent_id": 1,
      "agent_name": "Customer Interaction Agent",
      "action": "INTENT_AND_ORDER_EXTRACT",
      "description": "Analyzes complaint text, validates Order ID against DB, and classifies intent into 1 of 9 categories."
    },
    {
      "step": 2,
      "agent_id": 2,
      "agent_name": "Evidence Capture Agent",
      "action": "LIVE_CAMERA_GATE",
      "description": "Opens live camera WebRTC feed. Gallery selection is BLOCKED to prevent screen-replay & pre-recorded video fraud."
    },
    {
      "step": 3,
      "agent_id": 3,
      "agent_name": "CV Object Detection Agent",
      "sub_agents": [4],
      "action": "3LAYER_CV_AND_ANTIFRAUD_CHALLENGE",
      "cv_layers": [
        "1. MediaPipe Hand + Object Detection",
        "2. YOLO Frame-by-Frame Product Identity Match",
        "3. OpenCV Damage Region Segmentation"
      ],
      "anti_fraud_challenge": {
        "agent_id": 4,
        "triggers": ["MOIRE_PATTERN_DETECTED", "FRAME_UNIFORMITY_ANOMALY"],
        "challenge_types": ["LED_PEN_TEST", "360_ROTATION", "SHADOW_LIGHT_TEST", "DYNAMIC_SESSION_CODE"]
      }
    },
    {
      "step": 4,
      "agent_id": 5,
      "agent_name": "Evidence Verification Agent",
      "action": "SANDBOXED_OCR_DOCUMENT_VERIFICATION",
      "description": "Extracts text via OCR from Pipeline B invoice upload and cross-references line items with Order DB in sandbox isolation."
    },
    {
      "step": 5,
      "agent_id": 8,
      "agent_name": "Score Evaluation Agent",
      "sub_agents": [10, 11],
      "action": "ISOLATED_PIPELINE_SCORE_MERGE_AND_ROUTE",
      "routing_thresholds": {
        "auto_resolve": { "score_min": 80, "target_agent": 10, "action": "AUTO_REFUND_OR_REPLACEMENT" },
        "human_review": { "score_min": 50, "score_max": 79, "target_agent": 11, "action": "ESCALATE_TO_ADMIN_NO_BYPASS" },
        "fraud_reject": { "score_max": 49, "action": "CLOSE_CASE_AND_AUDIT_LOG" }
      }
    }
  ]
}
